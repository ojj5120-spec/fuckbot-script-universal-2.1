	local cam = workspace.CurrentCamera
	local maxByWidth = MAX_SCALE
	if cam and cam.ViewportSize.X > 0 then
		maxByWidth = (cam.ViewportSize.X - 10 - HANDLE_GAP - HANDLE_W - 6) / 200 -- que no se salga de la pantalla
