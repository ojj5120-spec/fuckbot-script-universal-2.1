local Debris = game:GetService("Debris")

local function playSound(character, id)
	if type(id) == "number" then
		id = "rbxassetid://" .. id
	end
	local part = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
	if not part then return end
	local snd = Instance.new("Sound")
	snd.SoundId = id
	snd.Volume = SOUND_VOLUME
	snd.Parent = part
	snd:Play()
	snd.Ended:Connect(function()
		snd:Destroy()
	end)
	Debris:AddItem(snd, 15)
end

-- Animaciones impares (1, 3, 5...) usan sonidos A; pares (2, 4, 6...) usan sonidos B
local function triggerSound(character, session)
	if session.kind == "A" then
		if soundAEnabled and #SOUNDS_A > 0 then
			session.aIndex = (session.aIndex % #SOUNDS_A) + 1
			playSound(character, SOUNDS_A[session.aIndex])
		end
	else
		-- Sonido B: el cooldown empieza de nuevo
		session.bCount = 0
		local list = session.sounds or SOUNDS_B
		if soundBEnabled and #list > 0 then
			playSound(character, list[math.random(1, #list)])
		end
		-- Cada sonido B cambia la cara (solo si tiene Mesh 2 y "Dynamic faces" esta activo)
		if DYN.facesOn and DYN.faceEvent then
			DYN.faceEvent(character, session)
		end
	end
end

-- Se llama al empezar cada pasada. Devuelve en que punto (0 a 1) de ESA pasada sonara el sonido, o nil si no suena
--  A: siempre en SOUND_POINT.
--  B: cuenta repeticiones; pasado el cooldown (4, o 3 si la velocidad es FAST_SPEED o mas) tira un dado en cada
--     repeticion y, si toca, suena en un punto al azar de la pasada.
function DYN.beginCycle(session, forward)
	if (SOUND_PASS == "forward") ~= forward then return nil end -- solo cuenta el tramo en el que suena
	if session.kind ~= "B" then return SOUND_POINT end
	if not (soundBEnabled or DYN.facesOn) then return nil end
	local cooldown = (speedMult >= DYN.FAST_SPEED) and DYN.B_COOLDOWN_FAST or DYN.B_COOLDOWN
	if session.bCount < cooldown then
		session.bCount += 1
		return nil
	end
	if math.random() < DYN.B_CHANCE then
		return DYN.B_POINT_MIN + math.random() * (DYN.B_POINT_MAX - DYN.B_POINT_MIN)
	end
	return nil
end

-- Reproduce la fase en LOOP (a -> b -> a -> b ...) hasta que session.stop sea true
local function playPhase(character, phase, originals, session)
	local joints = {}
	local maxDelay = 0

	for name, poseA in pairs(phase.a) do
		local poseB = phase.b[name]
		local joint = findJoint(character, name)
		if joint and poseB then
			if joint:IsA("Motor6D") and not originals[joint] then
				originals[joint] = joint.C0
			end
			local delay = math.max(phase.offsets[name] or 0, 0) * OFFSET_SCALE
			maxDelay = math.max(maxDelay, delay)
			table.insert(joints, { joint = joint, a = poseA, b = poseB, delay = delay })
		else
			warn("No encontrado en el personaje:", name)
		end
	end

	if #joints == 0 then
		return joints
	end

	local forward = true
	session.forward = true
	session.progress = 0
	session.pass = 0

	-- La velocidad nueva se aplica al empezar cada pasada
	local mult, duration, delayScale, total
	local function setup()
		mult = speedMult
		duration = BASE_DURATION / ((phase.speed or 1) * mult)
		delayScale = 1 / mult
		total = duration + maxDelay * delayScale
	end
	setup()

	local elapsed = 0
	local fired = false
	local lastLeaderPass = nil
	local soundPoint = DYN.beginCycle(session, true)

	while not session.stop and character.Parent do
		local dt = RunService.RenderStepped:Wait()
		if session.stop or not character.Parent then break end

		-- Con "Sync anim" activado, el que manda es TU animacion: los demas (botsito u otros jugadores)
		-- copian el sentido (a->b / b->a) y el punto exacto de la pasada en el que vas tu
		local leader = sessions[player]
		local following = syncAnimEnabled and leader ~= nil and leader ~= session
			and not leader.stop and leader.progress ~= nil
		if following then
			forward = leader.forward
			elapsed = leader.progress * total
			if leader.pass ~= lastLeaderPass then
				lastLeaderPass = leader.pass
				fired = false
				soundPoint = DYN.beginCycle(session, forward)
			end
		else
			lastLeaderPass = nil
			elapsed += dt * endSlow
		end

		for _, j in ipairs(joints) do
			local alpha = math.clamp((elapsed - j.delay * delayScale) / duration, 0, 1)
			local from, to = j.a, j.b
			if not forward then
				from, to = j.b, j.a
			end
			applyPose(j.joint, originals, from:Lerp(to, smooth(alpha)))
		end

		if soundPoint and not fired and elapsed >= total * soundPoint then
			fired = true
			triggerSound(character, session)
		end

		-- Estado que leen los que siguen
		session.forward = forward
		session.progress = math.clamp(elapsed / total, 0, 1)

		-- Fin de la pasada (solo el que va libre cambia de sentido)
		if not following and elapsed >= total then
			forward = not forward
			elapsed = 0
			fired = false
			soundPoint = DYN.beginCycle(session, forward)
			session.pass += 1
			session.forward = forward
			session.progress = 0
			setup()
		end
	end

	return joints
end

local function flash(text)
	button.Text = text
	task.wait(1.5)
	refreshButton()
end

-- Arranca la animacion de UN objetivo (jugador o botsito). Devuelve ok, cuantas juntas uso, o false + mensaje
local function startAnim(target, auto)
	local character = target.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false, "Sin personaje" end

	local isBotTarget = type(target) == "table" and target.isBot

	-- pareja de la animacion elegida (1-2, 3-4, 5-6...) y rol: 1 = impar, 2 = par. El botsito usa el rol contrario
	local selIdx = table.find(ANIM_ORDER, selected) or 1
	local base = (selIdx % 2 == 1) and selIdx or (selIdx - 1)
	local role = DYN.role
	if isBotTarget then role = 3 - role end
	local animIndex = base + role - 1
	local animName = ANIM_ORDER[animIndex] or selected
	local override = DYN.ANIM[animName]
	local session = {
		stop = false,
		auto = auto or false, -- true = lo arranco tu animacion automaticamente (solo botsito)
		aIndex = 0,
		bCount = 0,
		kind = (override and override.kind) or ((animIndex % 2 == 1) and "A" or "B"),
		anim = animName,
		sounds = (override and override.sounds and #override.sounds > 0) and override.sounds or nil,
	}
	sessions[target] = session
	refreshButton()

	-- Solo se puede frenar el Animate de tu propio personaje
	local animate, animator
	if target == player then
		animate = character:FindFirstChild("Animate")
		if animate then animate.Enabled = false end
		animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				track:Stop(0)
			end
		end
	end

	-- Sin colision mientras dura la animacion
	local noCollide = {}
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			noCollide[d] = d.CanCollide
		end
	end
	local collideConn = RunService.Stepped:Connect(function()
		for part in pairs(noCollide) do
			part.CanCollide = false
		end
	end)

	local originals = {}
	local used = {}
	local phase = data[animName]
	if phase then
		for _, j in ipairs(playPhase(character, phase, originals, session)) do
			table.insert(used, j.joint)
		end
	end

	-- Volver a la posicion normal
	for _, joint in ipairs(used) do
		if joint.Parent then
			if joint:IsA("Motor6D") then
				joint.C0 = originals[joint]
			else
				joint.Transform = CFrame.new()
			end
		end
	end

	collideConn:Disconnect()
	for part, was in pairs(noCollide) do
		if part.Parent then
			part.CanCollide = was
		end
	end

	if animate then animate.Enabled = true end

	sessions[target] = nil

	-- Si paraste tu (o cualquier jugador), el botsito automatico para tambien
	if not isBotTarget then
		local b = getBotProxy()
		local bs = b and sessions[b]
		if bs and bs.auto then bs.stop = true end
	end

	if DYN.face.resetOnStop and DYN.faceReset then
		DYN.faceReset(character)
	end
	return true, #used
end

button.MouseButton1Click:Connect(function()
	local target = findPlayer(box.Text)
	if not target then
		flash("No encontrado")
		return
	end

	local isBotTarget = type(target) == "table" and target.isBot

	-- Si ese jugador ya esta animandose, el click le para a el (y al botsito automatico)
	local existing = sessions[target]
	if existing then
		existing.stop = true
		if not isBotTarget then
			local b = getBotProxy()
			local bs = b and sessions[b]
			if bs and bs.auto then bs.stop = true end
		end
		return
	end

	local character = target.Character
	if not (character and character:FindFirstChildOfClass("Humanoid")) then
		flash("Sin personaje")
		return
	end

	-- Botsito automatico: hace la pareja con el rol contrario (solo si no esta ya animando por su cuenta)
	if not isBotTarget then
		local b = getBotProxy()
		if b and not sessions[b] then
			task.spawn(startAnim, b, true)
		end
	end

	local ok, usedCount = startAnim(target, false)
	if not ok then
		flash(usedCount)
	elseif usedCount == 0 then
		flash("No encontro juntas")
	else
		refreshButton()
	end
end)

