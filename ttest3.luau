	local function triggerEnd()
		if endRemaining > 0 then return end
		endSound:Play() -- suena al hacer click (solo si no esta en cooldown)
		playFlashbang()
		if DYN.facesOn and DYN.faceEnd then DYN.faceEnd() end
		endRemaining = END_COOLDOWN

		-- camara lenta un momento
		endSlow = END_SLOW
		task.delay(END_SLOW_TIME, function() endSlow = 1 end)

		-- decals en partes/caras al azar de cada personaje con Mesh 2
		for _, c in ipairs(getMorphTwoCharacters()) do
			addRandomDecals(c)
		end

		-- la barra se vacia y se va llenando durante el cooldown
		endFill.Size = UDim2.fromScale(0, 1)
		task.spawn(function()
			local last = os.clock()
			while endRemaining > 0 and not dead do
				endFill.Size = UDim2.fromScale(math.clamp(1 - endRemaining / END_COOLDOWN, 0, 1), 1)
				task.wait(0.05)
				local now = os.clock()
				local rate = (speedMult >= DYN.END_FAST_SPEED) and (1 / DYN.END_FAST_TICK) or 1
				endRemaining -= (now - last) * rate
				last = now
			end
			endRemaining = 0
			endFill.Size = UDim2.fromScale(1, 1)
		end)
	end
