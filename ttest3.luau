	;(function()
		------------------------------------------------------------
		-- BOT CATALOG: ventana con 15 accesorios del CATALOGO (por ID). Click en uno = se lo pone a botsito; click otra vez = se lo quita
		-- Los IDs se ponen arriba del todo, en DYN.CATALOG (id = numero del item del catalogo)
		------------------------------------------------------------
		local InsertService = game:GetService("InsertService")
		local catalogSel = {}      -- [slot] = item elegido
		local catalogButtons = {}  -- [item] = boton
		local assetCache = {}      -- [id] = Accessory plantilla ya descargada
		local catalogBusy = false  -- evita dos sincronizaciones a la vez
		local failedIds = {}       -- [id] = momento en que fallo la descarga (para no reintentar sin parar)
		local lastFail = { key = nil, t = 0 } -- ultima combinacion que no se pudo poner
		local catDiag = function(_) end -- se redefine mas abajo: muestra mensajes en la ventana del catalogo
		-- campo de HumanoidDescription que corresponde a cada tipo de accesorio (igual que usan los templates)
		local CAT_FIELDS = {
			Hair = "HairAccessory", Hat = "HatAccessory", Face = "FaceAccessory", Neck = "NeckAccessory",
			Back = "BackAccessory", Shoulder = "ShouldersAccessory", Front = "FrontAccessory", Waist = "WaistAccessory",
		}

		-- Ultimo motivo de fallo de cada descarga (se ensena en la ventana para saber que falla)
		local failWhy = {}
		local function why(id) return failWhy[id] or "?" end

		-- Ejecuta f() con limite de tiempo (en algunos executors GetObjects se queda colgado y bloqueaba todo el catalogo)
		local function withTimeout(sec, f)
			local done, ok, res = false, false, nil
			task.spawn(function()
				ok, res = pcall(f)
				done = true
			end)
			local t0 = os.clock()
			while not done and os.clock() - t0 < sec do task.wait(0.05) end
			if not done then return false, "tiempo agotado (" .. sec .. "s)" end
			return ok, res
		end

		-- Descarga el accesorio del catalogo (devuelve una plantilla, o nil si no se pudo)
		-- Prueba varios metodos seguidos: GetObjects con 3 formatos de url, LoadAsset y LoadLocalAsset
		local function loadCatalogAccessory(id)
			if assetCache[id] then return assetCache[id] end
			if failedIds[id] and os.clock() - failedIds[id] < 15 then return nil end

			local function extract(o)
				if typeof(o) ~= "Instance" then return nil end
				if o:IsA("Accessory") then return o end
				return o:FindFirstChildWhichIsA("Accessory", true)
			end
			local function fromList(objs)
				if typeof(objs) == "Instance" then objs = { objs } end
				if type(objs) ~= "table" then return nil end
				for _, o in ipairs(objs) do
					local a = extract(o)
					if a then return a end
				end
			end

			local errs = {}
			local acc
			local attempts = {
				{ "GetObjects", function() return fromList(game:GetObjects("rbxassetid://" .. id)) end },
				{ "GetObjects(http)", function() return fromList(game:GetObjects("http://www.roblox.com/asset/?id=" .. id)) end },
				{ "GetObjects(https)", function() return fromList(game:GetObjects("https://www.roblox.com/asset/?id=" .. id)) end },
				{ "LoadAsset", function() return extract(InsertService:LoadAsset(id)) end },
				{ "LoadLocalAsset", function() return extract(InsertService:LoadLocalAsset("rbxassetid://" .. id)) end },
			}
			for _, at in ipairs(attempts) do
				local ok, res = withTimeout(10, at[2])
				if ok and res then
					acc = res
					break
				end
				table.insert(errs, at[1] .. ": " .. (ok and "sin accesorio" or tostring(res):sub(1, 60)))
			end

			if acc then
				acc.Parent = nil
				assetCache[id] = acc
				failWhy[id] = nil
			else
				failedIds[id] = os.clock()
				failWhy[id] = errs[1] or "?"
				warn("[Catalog] No se pudo cargar el accesorio", id, table.concat(errs, " | "))
			end
			return acc
		end

		-- Suelda el accesorio a mano usando su Attachment (no depende de Humanoid:AddAccessory)
		local function attachManual(bot, acc)
			local handle = acc:FindFirstChild("Handle")
			local att = handle and handle:FindFirstChildWhichIsA("Attachment")
			if not att then return false end
			local target
			for _, p in ipairs(bot:GetChildren()) do
				if p:IsA("BasePart") then
					local a = p:FindFirstChild(att.Name)
					if a and a:IsA("Attachment") then target = a break end
				end
			end
			-- sin attachment con ese nombre: a la cabeza (o al torso) para que al menos se vea
			if not target then
				local part = bot:FindFirstChild("Head") or bot:FindFirstChild("Torso")
				if not part then return false end
				target = { Parent = part, CFrame = CFrame.new(0, part.Size.Y / 2, 0) }
			end
			for _, d in ipairs(handle:GetChildren()) do
				if d:IsA("Weld") or d:IsA("WeldConstraint") then d:Destroy() end
			end
			handle.Anchored = false
			handle.CanCollide = false
			handle.CanTouch = false
			handle.CanQuery = false
			handle.Massless = true
			local weld = Instance.new("Weld")
			weld.Name = "AccessoryWeld"
			weld.Part0 = target.Parent
			weld.Part1 = handle
			weld.C0 = target.CFrame
			weld.C1 = att.CFrame
			weld.Parent = handle
			acc.Parent = bot
			return true
		end

		-- Pone UN accesorio: primero Humanoid:AddAccessory y, si no queda soldado de verdad, a mano
		local function placeAccessory(bot, hum, acc)
			local okAdd = pcall(function() hum:AddAccessory(acc) end)
			if okAdd then
				task.wait(0.1)
				local handle = acc:FindFirstChild("Handle")
				local welded = acc.Parent == bot and handle and (handle:FindFirstChildWhichIsA("Weld") or handle:FindFirstChildWhichIsA("WeldConstraint")
					or handle:FindFirstChildWhichIsA("Motor6D"))
				if welded then return true end
			end
			-- AddAccessory fallo o dejo el accesorio suelto: se suelda a mano
			if acc.Parent ~= nil then acc.Parent = nil end
			return attachManual(bot, acc)
		end

		-- Estado de lo ultimo que se puso: { bot, key, method = "acc" / "desc" / "none", torso = bool }
		local catState = nil

		local function countAccessories(bot)
			local n = 0
			for _, c in ipairs(bot:GetChildren()) do
				if c:IsA("Accessory") then n += 1 end
			end
			return n
		end

		-- Deja en botsito justo lo elegido. Se llama en bucle: tambien lo vuelve a poner si botsito se respawnea
		-- o si un template / avatar le borra los accesorios (DYN.catalogDirty)
		local function syncCatalog(bot)
			if catalogBusy then return end
			local hum = bot and bot:FindFirstChildOfClass("Humanoid")
			if not hum then return end

			local list, accItems, torsoItem, ids = {}, {}, nil, {}
			local shirtItem, pantsItem = nil, nil
			for _, item in pairs(catalogSel) do
				if item.id and item.id ~= 0 then table.insert(list, item) end
			end
			table.sort(list, function(x, y) return x.id < y.id end)
			for _, it in ipairs(list) do
				table.insert(ids, tostring(it.id))
				if it.type == "Torso" then torsoItem = it
				elseif it.type == "Shirt" then shirtItem = it
				elseif it.type == "Pants" then pantsItem = it
				else table.insert(accItems, it) end
			end
			local key = table.concat(ids, ",")
			DYN.catalogTorso = torsoItem and torsoItem.id or nil -- DYN.wantedTorso lo usa en TODAS las rutas
			-- torso / camiseta / pantalon: solo se pueden poner (y quitar) con ApplyDescription
			local descOnly = torsoItem ~= nil or shirtItem ~= nil or pantsItem ~= nil

			local st = (catState and catState.bot == bot) and catState or nil
			local prevMethod = st and st.method or "none"
			local prevTorso = st and st.torso or false

			-- ya esta puesto? (se comprueba que de verdad siga en el bot)
			if st and st.key == key and not DYN.catalogDirty then
				local good = true
				if st.method == "acc" then
					local n = 0
					for _, c in ipairs(bot:GetChildren()) do
						if c:IsA("Accessory") and c:GetAttribute("CatalogKey") == key then n += 1 end
					end
					good = n >= #accItems
				elseif st.method == "desc" then
					good = countAccessories(bot) >= #accItems
				end
				if good then return end
			end

			-- nada elegido: solo hay que quitar lo que hubiera
			if key == "" and prevMethod ~= "desc" and not prevTorso then
				for _, c in ipairs(bot:GetChildren()) do
					if c:IsA("Accessory") and c:GetAttribute("CatalogKey") then c:Destroy() end
				end
				catState = { bot = bot, key = "", method = "none", torso = false }
				DYN.catalogDirty = false
				return
			end

			-- si acaba de fallar esta misma combinacion, no se reintenta hasta pasados unos segundos
			if key ~= "" and lastFail.key == key and os.clock() - lastFail.t < 10 then return end

			catalogBusy = true
			DYN.catalogDirty = false
			task.spawn(function()
				local method, got = "none", 0
				local need = #accItems
				local problems = {}
				local okAll, errAll = pcall(function()
					for _, c in ipairs(bot:GetChildren()) do
						if c:IsA("Accessory") and c:GetAttribute("CatalogKey") then c:Destroy() end
					end

					-- El torso (o quitar algo que se puso por descripcion) solo se puede hacer con ApplyDescription
					local useDesc = descOnly or prevMethod == "desc" or prevTorso

					-- Metodo 1: cargar los accesorios y soldarlos uno a uno
					if not useDesc and #accItems > 0 then
						local added, anyFail = {}, false
						for _, item in ipairs(accItems) do
							catDiag("Cargando " .. item.name .. "...")
							local tpl = loadCatalogAccessory(item.id)
							if tpl then
								local acc = tpl:Clone()
								acc:SetAttribute("CatalogKey", key)
								if placeAccessory(bot, hum, acc) then
									table.insert(added, acc)
								else
									acc:Destroy()
									anyFail = true
									table.insert(problems, item.name .. " (no se pudo soldar)")
								end
							else
								anyFail = true
								table.insert(problems, item.name .. " [" .. why(item.id) .. "]")
							end
						end
						if anyFail then
							-- mezclar metodos hace que desaparezcan accesorios: si falla uno, TODOS van por ApplyDescription
							for _, a2 in ipairs(added) do a2:Destroy() end
							useDesc = true
						else
							method = "acc"
							got = #added
						end
					end

					-- Metodo 2: HumanoidDescription con los campos de texto (lo descarga el propio Roblox, no depende del executor)
					if useDesc then
						method = "desc"
						catDiag("Aplicando por descripcion...")
						local okD, desc = pcall(function() return hum:GetAppliedDescription() end)
						if not okD or not desc then desc = Instance.new("HumanoidDescription") end
						-- IMPORTANTE: botsito no tiene BodyColors, asi que sin esto el cuerpo se pone NEGRO
						desc.HeadColor = currentColor
						desc.TorsoColor = currentColor
						desc.LeftArmColor = currentColor
						desc.RightArmColor = currentColor
						desc.LeftLegColor = currentColor
						desc.RightLegColor = currentColor

						local catIds = {}
						for _, it in ipairs(DYN.CATALOG) do
							if it.id and it.id ~= 0 then catIds[tostring(it.id)] = true end
						end
						local byField = {}
						for _, item in ipairs(accItems) do
							local field = CAT_FIELDS[item.type or "Hat"] or "HatAccessory"
							byField[field] = byField[field] or {}
							table.insert(byField[field], tostring(item.id))
						end
						-- en CADA campo: se quitan los ids del catalogo que hubiera y se ponen exactamente los elegidos ahora
						for _, field in pairs(CAT_FIELDS) do
							local keep = {}
							for id in string.gmatch(desc[field] or "", "%d+") do
								if not catIds[id] then table.insert(keep, id) end
							end
							for _, id in ipairs(byField[field] or {}) do table.insert(keep, id) end
							desc[field] = table.concat(keep, ",")
						end

						-- (el torso lo pone DYN.applyBotDesc: catalogo > template > avatar > ninguno)

						-- camiseta / pantalon: el del catalogo, o (si se quita) el del template / avatar / ninguno
						local tplC = currentTemplate and TEMPLATES[currentTemplate]
						local appC = botAppearance and botAppearance.desc
						if shirtItem then
							desc.Shirt = shirtItem.id
						elseif prevTorso then
							desc.Shirt = (tplC and tplC.shirt) or (appC and appC.Shirt) or 0
						end
						if pantsItem then
							desc.Pants = pantsItem.id
						elseif prevTorso then
							desc.Pants = (tplC and tplC.pants) or (appC and appC.Pants) or 0
						end

						local applied, err = DYN.applyBotDesc(hum, desc)
						if not applied then
							warn("[Catalog] Error en ApplyDescription:", err)
							table.insert(problems, "ApplyDescription: " .. tostring(err):sub(1, 80))
						end
					end
				end)

				if okAll then
					-- los accesorios pueden tardar un momento en aparecer: se espera un poco antes de darlo por fallido
					if method == "desc" and need > 0 then
						for _ = 1, 10 do
							if countAccessories(bot) >= need then break end
							task.wait(0.3)
						end
						got = countAccessories(bot)
					end
					if got >= need then
						catState = { bot = bot, key = key, method = method, torso = descOnly }
						lastFail = { key = nil, t = 0 }
						catDiag(key == "" and "Accesorios quitados" or ("OK: puesto (" .. method .. ")"))
					else
						warn("[Catalog] Solo se pusieron " .. got .. " de " .. need .. " | " .. table.concat(problems, " | "))
						lastFail = { key = key, t = os.clock() }
						catState = { bot = bot, key = "__fail", method = method, torso = descOnly }
						catDiag("No se pudo poner (" .. got .. "/" .. need .. "): " .. table.concat(problems, "; "))
					end
				else
					warn("[Catalog] Error:", errAll)
					lastFail = { key = key, t = os.clock() }
					catState = { bot = bot, key = "__fail", method = method, torso = descOnly }
					catDiag("Error: " .. tostring(errAll))
				end
				catalogBusy = false
			end)
		end

		local catalogWin = Instance.new("Frame")
		catalogWin.Name = "BotCatalog"
		catalogWin.Size = UDim2.fromOffset(230, 330)
		catalogWin.AnchorPoint = Vector2.new(0.5, 0.5)
		catalogWin.Position = UDim2.new(0.5, 30, 0.5, 30)
		catalogWin.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		catalogWin.BorderSizePixel = 0
		catalogWin.Active = true
		catalogWin.Visible = false
		catalogWin.Parent = gui
		Instance.new("UICorner", catalogWin).CornerRadius = UDim.new(0, 10)

		local catalogScale = Instance.new("UIScale")
		catalogScale.Scale = math.min(frameScale.Scale, 1)
		catalogScale.Parent = catalogWin
		frameScale:GetPropertyChangedSignal("Scale"):Connect(function()
			catalogScale.Scale = math.min(frameScale.Scale, 1)
		end)

		local catTitle = Instance.new("TextLabel")
		catTitle.Size = UDim2.fromOffset(150, 20)
		catTitle.Position = UDim2.fromOffset(10, 8)
		catTitle.BackgroundTransparency = 1
		catTitle.Font = Enum.Font.GothamBold
		catTitle.TextSize = 14
		catTitle.TextXAlignment = Enum.TextXAlignment.Left
		catTitle.TextColor3 = Color3.new(1, 1, 1)
		catTitle.Text = "Bot catalog"
		catTitle.Parent = catalogWin

		local function catButton(text, x, y, w, h)
			local b = Instance.new("TextButton")
			b.Size = UDim2.fromOffset(w, h)
			b.Position = UDim2.fromOffset(x, y)
			b.Text = text
			b.Font = Enum.Font.GothamBold
			b.TextSize = 12
			b.TextColor3 = Color3.new(1, 1, 1)
			b.BackgroundColor3 = COLOR_OFF
			b.BorderSizePixel = 0
			b.Parent = catalogWin
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
			return b
		end

		local catClose = catButton("X", 190, 6, 30, 24)
		catClose.BackgroundColor3 = COLOR_FALSE
		local catClear = catButton("Quitar todo", 10, 36, 210, 26)

		local catStatus = Instance.new("TextLabel")
		catStatus.Size = UDim2.fromOffset(210, 28)
		catStatus.TextTruncate = Enum.TextTruncate.AtEnd
		catStatus.Position = UDim2.fromOffset(10, 66)
		catStatus.BackgroundTransparency = 1
		catStatus.Font = Enum.Font.Gotham
		catStatus.TextSize = 11
		catStatus.TextWrapped = true
		catStatus.TextXAlignment = Enum.TextXAlignment.Left
		catStatus.TextYAlignment = Enum.TextYAlignment.Top
		catStatus.TextColor3 = Color3.fromRGB(170, 170, 170)
		catStatus.Text = "Toca un accesorio para ponerselo a botsito"
		catStatus.Parent = catalogWin
		catDiag = function(t) catStatus.Text = t end

		local catList = Instance.new("ScrollingFrame")
		catList.Size = UDim2.fromOffset(210, 226)
		catList.Position = UDim2.fromOffset(10, 98)
		catList.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		catList.BorderSizePixel = 0
		catList.ScrollBarThickness = 4
		catList.CanvasSize = UDim2.fromOffset(0, 0)
		catList.AutomaticCanvasSize = Enum.AutomaticSize.Y
		catList.Parent = catalogWin
		Instance.new("UICorner", catList).CornerRadius = UDim.new(0, 8)
		local catLayout = Instance.new("UIListLayout")
		catLayout.Padding = UDim.new(0, 3)
		catLayout.SortOrder = Enum.SortOrder.LayoutOrder
		catLayout.Parent = catList
		local catPad = Instance.new("UIPadding")
		catPad.PaddingTop = UDim.new(0, 4)
		catPad.PaddingLeft = UDim.new(0, 4)
		catPad.PaddingRight = UDim.new(0, 4)
		catPad.PaddingBottom = UDim.new(0, 4)
		catPad.Parent = catList

		local function refreshCatalogButtons()
			for item, b in pairs(catalogButtons) do
				b.BackgroundColor3 = (catalogSel[item] == item) and COLOR_ON or COLOR_OFF
			end
		end

		local function catalogStatusText(text)
			if findBots()[1] then
				catStatus.Text = text
			else
				catStatus.Text = text .. " (se pondra cuando spawnees a botsito)"
			end
		end

		for i, item in ipairs(DYN.CATALOG) do
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.Size = UDim2.new(1, 0, 0, 28)
			b.Text = (item.id == 0) and (item.name .. " (falta ID)") or item.name
			b.TextTruncate = Enum.TextTruncate.AtEnd
			b.Font = Enum.Font.Gotham
			b.TextSize = 13
			b.TextColor3 = Color3.new(1, 1, 1)
			b.BackgroundColor3 = COLOR_OFF
			b.BorderSizePixel = 0
			b.Parent = catList
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
			b.MouseButton1Click:Connect(function()
				if not item.id or item.id == 0 then
					catStatus.Text = "Falta el ID de " .. item.name .. " (ponlo en DYN.CATALOG, arriba del script)"
					return
				end
				if catalogSel[item] then
					catalogSel[item] = nil -- segundo click: se lo quita (solo a ese)
					catalogStatusText("Quitado: " .. item.name)
				else
					if item.type == "Shirt" or item.type == "Pants" then
						-- ropa clasica: solo una de cada tipo, la nueva reemplaza a la anterior
						for other in pairs(catalogSel) do
							if other.type == item.type then catalogSel[other] = nil end
						end
					end
					catalogSel[item] = item -- se SUMA a lo que ya lleva (los accesorios ya no reemplazan por slot)
					catalogStatusText("Puesto: " .. item.name)
				end
				refreshCatalogButtons()
				DYN.updateCatalogTorso(catalogSel)
				syncCatalog(findBots()[1])
			end)
			catalogButtons[item] = b
		end

		catClear.MouseButton1Click:Connect(function()
			catalogSel = {}
			refreshCatalogButtons()
			DYN.updateCatalogTorso(catalogSel)
			syncCatalog(findBots()[1])
			catStatus.Text = "Accesorios quitados"
		end)

		task.spawn(function()
			while not dead do
				syncCatalog(findBots()[1])
				task.wait(0.4)
			end
		end)

		local catalogBtn = makeButton("Bot catalog", 10, appearY + 30)
		catalogBtn.Size = UDim2.fromOffset(180, 26)
		local function openCatalog(v)
			catalogWin.Visible = v
			catalogBtn.BackgroundColor3 = v and COLOR_ON or COLOR_OFF
		end
		catalogBtn.MouseButton1Click:Connect(function()
			openCatalog(not catalogWin.Visible)
		end)
		catClose.MouseButton1Click:Connect(function() openCatalog(false) end)
		hideBtn.MouseButton1Click:Connect(function() openCatalog(false) end)

	end)()

	;(function()
		------------------------------------------------------------
		-- DYNAMIC FACES: la tiene quien este haciendo una animacion (par: cambia con cada sonido B;
		-- impar: cambia al azar con cooldown; End: cara especial 3.5 s y luego fast / B / odd)
		------------------------------------------------------------
		local TweenService = game:GetService("TweenService")
		local ContentProvider = game:GetService("ContentProvider")
		local FACE_FEATURES = { "eyes", "brows", "mouth" }
		local faceRigs = setmetatable({}, { __mode = "k" }) -- [personaje] = rig con los decals de su cara
		local faceTex = nil
		local facesReady = false

		local function buildFaceTex()
			faceTex = {}
			local defs = {}
			for _, set in ipairs({ "default", "soundB", "fast", "odd", "endFace", "endOdd", "endB" }) do
				defs[set] = DYN.FACES[set] or {}
			end
			-- caras propias de una animacion: clave "animacion.juego" (solo si tienen algun id)
			for name, cfg in pairs(DYN.ANIM) do
				for set, def in pairs(cfg.faces or {}) do
					for _, f in ipairs(FACE_FEATURES) do
						if def[f] and #def[f] > 0 then
							defs[name .. "." .. set] = def
							break
						end
					end
				end
			end
			for key, def in pairs(defs) do
				faceTex[key] = {}
				for _, f in ipairs(FACE_FEATURES) do
					local list = {}
					for _, id in ipairs(def[f] or {}) do
						local t = normalizeId(id)
						if t then table.insert(list, t) end
					end
					faceTex[key][f] = list
				end
			end
		end

		-- Juego de cara de una sesion: el propio de su animacion si lo tiene, si no el general
		local function fset(sess, set)
			if sess and sess.anim then
				local own = faceTex[sess.anim .. "." .. set]
				if own then return own end
			end
			return faceTex[set]
		end

		local function hasDefaultFace()
			for _, f in ipairs(FACE_FEATURES) do
				if #faceTex.default[f] > 0 then return true end
			end
			return false
		end

		local function hideOriginalFace(head)
			for _, d in ipairs(head:GetChildren()) do
				if d:IsA("Decal") and d.Name == "face" and d.Transparency < 1 then
					d:SetAttribute("DynFaceOrigT", d.Transparency)
					d.Transparency = 1
				end
			end
		end
		local function restoreOriginalFace(head)
			for _, d in ipairs(head:GetChildren()) do
				if d:IsA("Decal") and d:GetAttribute("DynFaceOrigT") ~= nil then
					d.Transparency = d:GetAttribute("DynFaceOrigT")
					d:SetAttribute("DynFaceOrigT", nil)
				end
			end
		end

		local function makeRig(character)
			local head = character:FindFirstChild("Head")
			if not head or not head:IsA("BasePart") then return nil end
			local rig = { head = head }
			for _, f in ipairs(FACE_FEATURES) do
				local slot = { active = 1, tex = "", decals = {}, tweens = {} }
				for i = 1, 2 do
					local d = Instance.new("Decal")
					d.Name = "DynFace_" .. f
					d.Face = DYN.face.side
					d.ZIndex = DYN.face.z[f] or 1
					d.Texture = ""
					d.Transparency = 1
					d.Parent = head
					slot.decals[i] = d
				end
				rig[f] = slot
			end
			hideOriginalFace(head)
			faceRigs[character] = rig
			return rig
		end

		local function destroyRig(character)
			local rig = faceRigs[character]
			if not rig then return end
			faceRigs[character] = nil
			for _, f in ipairs(FACE_FEATURES) do
				for _, tw in ipairs(rig[f].tweens) do tw:Cancel() end
				for _, d in ipairs(rig[f].decals) do d:Destroy() end
			end
			if rig.head and rig.head.Parent then
				restoreOriginalFace(rig.head)
			end
		end

		local function setFeature(rig, f, tex, instant)
			local slot = rig[f]
			tex = tex or ""
			if slot.tex == tex then return end
			slot.tex = tex
			for _, tw in ipairs(slot.tweens) do tw:Cancel() end
			slot.tweens = {}
			local old = slot.decals[slot.active]
			slot.active = 3 - slot.active
			local new = slot.decals[slot.active]
			new.Texture = tex
			if instant then
				new.Transparency = (tex == "") and 1 or 0
				old.Transparency = 1
				return
			end
			new.Transparency = 1
			local info = TweenInfo.new(DYN.face.fade, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			local tOut = TweenService:Create(old, info, { Transparency = 1 })
			slot.tweens[1] = tOut
			tOut:Play()
			if tex ~= "" then
				local tIn = TweenService:Create(new, info, { Transparency = 0 })
				slot.tweens[2] = tIn
				tIn:Play()
			end
		end

		local function pick(list, fallback, current)
			local l = list
			if #l == 0 then l = { fallback[1] } end
			if #l == 0 then return "" end
			if #l == 1 then return l[1] end
			local choice = l[math.random(#l)]
			for _ = 1, 8 do
				if choice ~= current then break end
				choice = l[math.random(#l)]
			end
			return choice
		end

		local function resetFace(character, instant)
			local rig = faceRigs[character]
			if not rig or not faceTex then return end
			for _, f in ipairs(FACE_FEATURES) do
				setFeature(rig, f, faceTex.default[f][1] or "", instant)
			end
		end

		-- Juegos de cara
		local function setB(rig, sess) -- animacion par, velocidad normal: cambian ojos y boca, cejas default
			local D, B = faceTex.default, fset(sess, "soundB")
			setFeature(rig, "eyes", pick(B.eyes, D.eyes, rig.eyes.tex))
			setFeature(rig, "mouth", pick(B.mouth, D.mouth, rig.mouth.tex))
			setFeature(rig, "brows", D.brows[1] or "")
		end
		local function setFast(rig, sess) -- rapido: ojos siempre los mismos, cambian boca y cejas
			local D, F = faceTex.default, fset(sess, "fast")
			setFeature(rig, "eyes", F.eyes[1] or D.eyes[1] or "")
			setFeature(rig, "mouth", pick(F.mouth, D.mouth, rig.mouth.tex))
			setFeature(rig, "brows", pick(F.brows, D.brows, rig.brows.tex))
		end
		local function setOdd(rig, sess) -- animacion impar
			local D, O = faceTex.default, fset(sess, "odd")
			for _, f in ipairs(FACE_FEATURES) do
				setFeature(rig, f, pick(O[f], D[f], rig[f].tex))
			end
		end
		local function setEnd(rig, sess) -- cara del boton End (finish): distinta para impares (endOdd) y para B (endB)
			local D = faceTex.default
			local E = fset(sess, (sess and sess.kind == "B") and "endB" or "endOdd")
			local any = false
			for _, f in ipairs(FACE_FEATURES) do
				if #E[f] > 0 then any = true break end
			end
			if not any then E = faceTex.endFace end -- vacio: cara de End general
			for _, f in ipairs(FACE_FEATURES) do
				setFeature(rig, f, pick(E[f], D[f], rig[f].tex))
			end
		end

		-- Se llama cada vez que suena un sonido B (animaciones pares)
		local function onFaceEvent(character, sess)
			if not DYN.facesOn or not faceTex or not facesReady then return end
			if os.clock() < DYN.endFaceUntil then return end -- durante End manda la cara de End
			local rig = faceRigs[character]
			if not rig then
				if not hasDefaultFace() then return end
				rig = makeRig(character)
				if not rig then return end
			end
			if speedMult >= DYN.FAST_SPEED then setFast(rig, sess) else setB(rig, sess) end
		end
		DYN.faceEvent = onFaceEvent
		DYN.faceReset = function(character)
			if DYN.facesOn and facesReady then
				resetFace(character)
			end
		end

		-- Se llama al pulsar End: cara de End a todos los que estan animando y, a los 3.5 s, fast / B / odd
		DYN.faceEnd = function()
			if not DYN.facesOn or not faceTex or not facesReady or not hasDefaultFace() then return end
			local untilT = os.clock() + DYN.END_FACE_TIME
			DYN.endFaceUntil = untilT
			for target, sess in pairs(sessions) do
				local c = target.Character
				if c and c.Parent then
					local rig = faceRigs[c] or makeRig(c)
					if rig then setEnd(rig, sess) end
				end
			end
			task.delay(DYN.END_FACE_TIME, function()
				if dead or DYN.endFaceUntil ~= untilT then return end
				for target, sess in pairs(sessions) do
					local c = target.Character
					local rig = c and faceRigs[c]
					if rig then
						if speedMult >= DYN.FAST_SPEED then
							setFast(rig, sess)
						elseif sess.kind == "B" then
							setB(rig, sess)
						else
							setOdd(rig, sess)
						end
						sess.nextOddFace = os.clock() + DYN.ODD_COOLDOWN
					end
				end
			end)
		end

		-- Vigila a todos los que estan animando: les pone la cara default, cambia la cara de las impares
		-- al azar (con cooldown) y se la quita a los que ya no animan
		task.spawn(function()
			while not dead do
				if DYN.facesOn and faceTex and facesReady then
					local active = {}
					local now = os.clock()
					for target, sess in pairs(sessions) do
						local c = target.Character
						if c and c.Parent and c:FindFirstChild("Head") then
							active[c] = true
							local rig = faceRigs[c]
							if rig and (not rig.head.Parent or rig.head ~= c:FindFirstChild("Head")) then
								destroyRig(c)
								rig = nil
							end
							if rig then
								hideOriginalFace(rig.head)
							elseif hasDefaultFace() then
								rig = makeRig(c)
								if rig then
									resetFace(c, true)
									sess.nextOddFace = now + DYN.ODD_COOLDOWN
								end
							end
							-- impares: cambio random, minimo ODD_COOLDOWN segundos entre uno y otro
							if rig and sess.kind == "A" and now >= DYN.endFaceUntil
								and now >= (sess.nextOddFace or 0) and math.random() < DYN.ODD_CHANCE then
								setOdd(rig, sess)
								sess.nextOddFace = now + DYN.ODD_COOLDOWN
							end
						end
					end
					local stale = {}
					for c in pairs(faceRigs) do
						if not active[c] then table.insert(stale, c) end
					end
					for _, c in ipairs(stale) do destroyRig(c) end
				end
				task.wait(0.3)
			end
		end)

		local facesBtn = makeButton("Dynamic faces", 10, appearY + 60)
		facesBtn.Size = UDim2.fromOffset(180, 26)
		local facesFlash = 0
		facesBtn.MouseButton1Click:Connect(function()
			if DYN.facesOn then
				DYN.facesOn = false
				local all = {}
				for c in pairs(faceRigs) do table.insert(all, c) end
				for _, c in ipairs(all) do destroyRig(c) end
				facesBtn.BackgroundColor3 = COLOR_OFF
				return
			end
			buildFaceTex()
			if not hasDefaultFace() then
				warn("[Dynamic faces] Faltan los IDs: pon las texturas en DYN.FACES.default (ojos, cejas y boca) al principio del script")
				facesFlash += 1
				local my = facesFlash
				facesBtn.Text = "Faltan IDs (FACES)"
				facesBtn.BackgroundColor3 = COLOR_FALSE
				task.delay(2, function()
					if my == facesFlash then
						facesBtn.Text = "Dynamic faces"
						facesBtn.BackgroundColor3 = COLOR_OFF
					end
				end)
				return
			end
			DYN.facesOn = true
			facesReady = false
			facesBtn.BackgroundColor3 = COLOR_ON
			task.spawn(function()
				local list = {}
				for _, set in pairs(faceTex) do
					for _, texs in pairs(set) do
						for _, t in ipairs(texs) do table.insert(list, t) end
					end
				end
				pcall(function() ContentProvider:PreloadAsync(list) end)
				facesReady = true
			end)
		end)

		-- Al cerrar el script: las caras normales vuelven
		killEvent.Event:Connect(function()
			DYN.facesOn = false
			DYN.faceEvent = nil
			DYN.faceReset = nil
			DYN.faceEnd = nil
			local all = {}
			for c in pairs(faceRigs) do table.insert(all, c) end
			for _, c in ipairs(all) do pcall(destroyRig, c) end
		end)
	end)()

