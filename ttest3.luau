	-- Cambia el color del botsito (partes + BodyColors si existe)
	local function paintBot(color)
		currentColor = color
		local bot = findBots()[1]
		if not bot then return end
		for _, n in ipairs({ "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }) do
			local part = bot:FindFirstChild(n)
			if part and part:IsA("BasePart") then
				part.Color = color
			end
		end
		for _, d in ipairs(bot:GetChildren()) do
			if d.Name == "MorphMesh" and not d:GetAttribute("FixedColor") then
				d.Color = color
			end
		end
		local bc = bot:FindFirstChildOfClass("BodyColors")
		if bc then
			bc.HeadColor3 = color
			bc.TorsoColor3 = color
			bc.LeftArmColor3 = color
			bc.RightArmColor3 = color
			bc.LeftLegColor3 = color
			bc.RightLegColor3 = color
		end
	end

	for i, name in ipairs(PALETTE) do
