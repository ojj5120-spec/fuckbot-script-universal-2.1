-- Elegir un template: pone la apariencia Y su morph al botsito
function DYN.selectTemplate(i)
	currentTemplate = i
	botAppearance = nil
	refreshTemplateButtons()
	local m = TEMPLATES[i] and TEMPLATES[i].morph
	if m then
		botMorph = m[1]
		DYN.botMorphVar = m[2] or 1 -- se vuelve a poner si respawneas a botsito
	end
	local bot = findBots()[1]
	if bot then
		task.spawn(function()
			if m then
				if buildMorph(bot, m[1], m[2] or 1) > 0 then
					bot:SetAttribute("MorphIdx", m[1])
					bot:SetAttribute("MorphVariant", m[2] or 1)
				else
					bot:SetAttribute("MorphIdx", nil)
					bot:SetAttribute("MorphVariant", nil)
				end
				if DYN.refreshMorph then DYN.refreshMorph() end
			end
			applyTemplate(bot, i)
		end)
	end
end

