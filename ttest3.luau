-- Animacion
local function findJoint(character, name)
	for _, inst in ipairs(character:GetDescendants()) do
		if inst.Name == name and (inst:IsA("Motor6D") or inst:IsA("Bone")) then
			return inst
		end
	end
	return nil
end

local function smooth(t)
	return t * t * (3 - 2 * t)
end

-- Motor6D: se mueve el C0. Bone: se usa Transform.
local function applyPose(joint, originals, cf)
	if not joint.Parent then return end
	if joint:IsA("Motor6D") then
		joint.C0 = originals[joint] * cf
	else
		joint.Transform = cf
	end
end

