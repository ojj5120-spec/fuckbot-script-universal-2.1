		local parts = getDecalParts(character)
		if #parts == 0 then return end
		local used = {} -- combinaciones parte+cara ya usadas (para no apilar dos decals en el mismo sitio)
		for i = 1, DECAL_COUNT do
			local part, face
			for _ = 1, 20 do -- intenta hasta 20 veces encontrar un sitio libre
				part = parts[math.random(#parts)]
				face = DECAL_FACES[math.random(#DECAL_FACES)]
				if not used[part] then used[part] = {} end
				if not used[part][face] then break end
			end
			used[part] = used[part] or {}
			used[part][face] = true
			local d = Instance.new("Decal")
