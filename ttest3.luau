-- MORPHS: meshes que se sueldan al torso (sin colision, SmoothPlastic, del color del cuerpo)
--   meshId   = ID del MeshPart (numero o "rbxassetid://ID"). 0 = no se pone
--   textureId= (opcional) ID de textura, "" = sin textura
--   offset   = DONDE va, relativo al centro del torso, en studs: X (+derecha / -izquierda), Y (+arriba / -abajo), Z (-delante / +detras)
--   rotation = giro en GRADOS (X, Y, Z)
--   size     = TAMANO final en studs (X, Y, Z)
--   color    = (opcional) color fijo, ej. color = MAUVE. Sin esto el mesh toma el color del cuerpo
--   physics  = (opcional) true = el mesh tiene "fisicas": rebota / se inclina con los saltos, caidas y movimientos (ver PHYS)
-- "Mesh 1" pone 3 meshes, "Mesh 2" pone 6. Tocar el mismo boton otra vez lo quita.
local MAUVE = Color3.fromRGB(224, 176, 255) -- color mauve (cambialo si lo quieres mas claro/oscuro)
-- PHYS: ajustes de las fisicas (solo para los meshes con physics = true)
local PHYS = {
	stiffness = 140,   -- fuerza del muelle: mas alto = vuelve antes a su sitio
	damping = 7,       -- freno: mas BAJO = rebota mas tiempo
	pitchGain = 3,     -- cuanto se inclina arriba/abajo (grados por cada stud/s de cambio de velocidad vertical). NEGATIVO = al reves
	rollGain = 1,      -- cuanto se inclina a los lados
	moveGain = 0.02,   -- cuanto sube/baja el mesh (studs)
	maxPitch = 25,     -- inclinacion maxima (grados)
	maxRoll = 12,      -- inclinacion lateral maxima (grados)
	maxMove = 0.25,    -- desplazamiento vertical maximo (studs)
	maxImpulse = 60,   -- limite al cambio de velocidad por frame (evita tirones raros)
}
