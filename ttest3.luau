-- speed negativa (viene en alguna animacion): se invierte el sentido (a <-> b) y se usa el valor absoluto
for _, ph in pairs(data) do
	if type(ph) == "table" and type(ph.speed) == "number" and ph.speed ~= 0 and ph.a and ph.b then
		if ph.speed < 0 then
			ph.a, ph.b = ph.b, ph.a
		end
		ph.speed = math.abs(ph.speed)
	end
end

