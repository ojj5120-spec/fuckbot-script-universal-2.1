-- botsito como objetivo: se comporta como un "jugador" para esta GUI (tiene Name, DisplayName y Character)
local BOT_NAME = "botsito"
local botProxy = nil

local function getBotProxy()
	local bot = workspace:FindFirstChild(BOT_NAME)
	if not bot or not bot:IsA("Model") then
		botProxy = nil
		return nil
	end
	-- El mismo proxy mientras sea el mismo botsito (asi la sesion de animacion se mantiene)
	if not botProxy or botProxy.Character ~= bot then
		botProxy = { Name = BOT_NAME, DisplayName = BOT_NAME, Character = bot, isBot = true }
	end
	return botProxy
end

-- Busqueda por nombre: jugadores + botsito en la misma lista.
-- Orden: nombre exacto, luego empieza por lo escrito, luego lo contiene.
local matchIndex = 1
local lastQuery = nil

local function getMatches(query)
	local exact, prefix, contains = {}, {}, {}
	local candidates = Players:GetPlayers()
	local bot = getBotProxy()
	if bot then
		table.insert(candidates, bot)
	end
	for _, p in ipairs(candidates) do
		local n = string.lower(p.Name)
		local d = string.lower(p.DisplayName)
		if n == query or d == query then
			table.insert(exact, p)
		elseif n:sub(1, #query) == query or d:sub(1, #query) == query then
			table.insert(prefix, p)
		elseif n:find(query, 1, true) or d:find(query, 1, true) then
			table.insert(contains, p)
		end
	end
	local result = {}
	for _, group in ipairs({ exact, prefix, contains }) do
		for _, p in ipairs(group) do
			table.insert(result, p)
		end
	end
	return result
end

-- Devuelve el objetivo elegido y cuantas coincidencias hay
local function findPlayer(query)
	query = string.lower(query):match("^%s*(.-)%s*$")
	if query == "" then
		return player, 1
	end
	if query ~= lastQuery then
		lastQuery = query
		matchIndex = 1
	end
	local matches = getMatches(query)
	if #matches == 0 then
		return nil, 0
	end
	matchIndex = ((matchIndex - 1) % #matches) + 1
	return matches[matchIndex], #matches
end

