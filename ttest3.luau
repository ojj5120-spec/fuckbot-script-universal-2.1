	------------------------------------------------------------
	-- FPV: primera persona de quien este animando (jugador o botsito)
	-- La camara se queda delante de la cabeza, se ve el cuerpo y girar la camara NO gira al personaje
	------------------------------------------------------------
	local FPV_FORWARD = 1     -- studs que la camara va por delante de la cabeza
	local FPV_SENS = 0.3       -- grados por pixel al girar la camara
	local FPV_NAME = "PlayAnimFPV"
	local fpv = nil            -- { target, yaw, pitch, rmb, parts, tick }
	local fpvConns = {}

	local fpvBtn = makeButton("fpv", 10, fpvY)
	fpvBtn.Size = UDim2.fromOffset(180, 26)

	local function stopFPV()
		pcall(function() RunService:UnbindFromRenderStep(FPV_NAME) end)
		for _, c in ipairs(fpvConns) do pcall(function() c:Disconnect() end) end
		fpvConns = {}
		if fpv then
			fpv = nil
			local cam = workspace.CurrentCamera
			local ch = player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if cam then
				cam.CameraType = Enum.CameraType.Custom
				if hum then cam.CameraSubject = hum end
			end
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		fpvBtn.Text = "fpv"
		fpvBtn.BackgroundColor3 = COLOR_OFF
	end

	local function startFPV(target)
		stopFPV()
		local char = target and target.Character
		local head = char and char:FindFirstChild("Head")
		local cam = workspace.CurrentCamera
		if not head or not cam then return end

		local look = head.CFrame.LookVector
		fpv = {
			target = target,
			yaw = math.atan2(-look.X, -look.Z),
			pitch = 0,
			rmb = false,
			parts = {},
			tick = 0,
		}
		cam.CameraType = Enum.CameraType.Scriptable
		fpvBtn.Text = "fpv (salir)"
		fpvBtn.BackgroundColor3 = COLOR_ON

		table.insert(fpvConns, UserInputService.InputBegan:Connect(function(input, gp)
			if fpv and input.UserInputType == Enum.UserInputType.MouseButton2 then
				fpv.rmb = true
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			end
		end))
		table.insert(fpvConns, UserInputService.InputEnded:Connect(function(input)
			if fpv and input.UserInputType == Enum.UserInputType.MouseButton2 then
				fpv.rmb = false
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end))
		table.insert(fpvConns, UserInputService.InputChanged:Connect(function(input, gp)
			if not fpv then return end
			local t = input.UserInputType
			if (t == Enum.UserInputType.MouseMovement and fpv.rmb) or (t == Enum.UserInputType.Touch and not gp) then
				fpv.yaw -= math.rad(input.Delta.X * FPV_SENS)
				fpv.pitch = math.clamp(fpv.pitch - math.rad(input.Delta.Y * FPV_SENS), math.rad(-85), math.rad(85))
			end
		end))

		RunService:BindToRenderStep(FPV_NAME, Enum.RenderPriority.Camera.Value + 1, function()
			local f = fpv
			if not f then return end
			local c = f.target.Character
			local h = c and c:FindFirstChild("Head")
			-- si deja de animar (o desaparece) se sale solo
			if not c or not c.Parent or not h or not sessions[f.target] then
				stopFPV()
				return
			end
			local camera = workspace.CurrentCamera
			camera.CameraType = Enum.CameraType.Scriptable
			local rot = CFrame.Angles(0, f.yaw, 0) * CFrame.Angles(f.pitch, 0, 0)
			camera.CFrame = CFrame.new(h.Position) * rot * CFrame.new(0, 0, -FPV_FORWARD)

			-- que se vea el cuerpo (Roblox oculta el personaje propio en primera persona)
			f.tick -= 1
			if f.tick <= 0 then
				f.tick = 30
				f.parts = {}
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("BasePart") then table.insert(f.parts, d) end
				end
			end
			for _, part in ipairs(f.parts) do
				part.LocalTransparencyModifier = 0
			end
		end)
	end

