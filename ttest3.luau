	local fpvSig = nil
	local function refreshFpvList()
		local entries = {}
		for target in pairs(sessions) do
			table.insert(entries, target)
		end
		table.sort(entries, function(a, b) return a.Name < b.Name end)
		local names = {}
		for _, t in ipairs(entries) do table.insert(names, t.Name) end
		local sig = table.concat(names, "|")
		if sig == fpvSig then return end
		fpvSig = sig

		for _, c in ipairs(fpvList:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		fpvEmpty.Visible = #entries == 0
		fpvList.Visible = #entries > 0
		for i, t in ipairs(entries) do
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.Size = UDim2.new(1, 0, 0, 26)
			local label = t.DisplayName .. " (@" .. t.Name .. ")"
			if t == player then label = "Tu (" .. t.Name .. ")" end
			b.Text = label
			b.TextTruncate = Enum.TextTruncate.AtEnd
			b.Font = Enum.Font.Gotham
			b.TextSize = 12
			b.TextColor3 = Color3.new(1, 1, 1)
			b.BackgroundColor3 = COLOR_OFF
			b.BorderSizePixel = 0
			b.Parent = fpvList
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
			b.MouseButton1Click:Connect(function()
				fpvWin.Visible = false
				startFPV(t)
			end)
		end
	end

	task.spawn(function()
		while not dead and fpvWin.Parent do
			if fpvWin.Visible then refreshFpvList() end
			task.wait(0.4)
		end
	end)

	fpvBtn.MouseButton1Click:Connect(function()
		if fpv then
			stopFPV()
			return
		end
		fpvWin.Visible = not fpvWin.Visible
		if fpvWin.Visible then
			fpvSig = nil
			refreshFpvList()
		end
	end)
	fpvClose.MouseButton1Click:Connect(function() fpvWin.Visible = false end)
	hideBtn.MouseButton1Click:Connect(function() fpvWin.Visible = false end)

	------------------------------------------------------------
	-- ANIMACIONES plegable: todo lo que va debajo de la cuadricula sube / baja cuando se cierra / abre
	------------------------------------------------------------
	local belowItems = {}
	for _, c in ipairs(frame:GetChildren()) do
		if c:IsA("GuiObject") and c.Position.Y.Scale == 0 and c.Position.Y.Offset >= playY - 0.5 then
			belowItems[c] = { pos = c.Position, afterTpl = c.Position.Y.Offset >= syncY - 0.5 }
		end
	end
	local function applyAnimLayout()
		local aShift = DYN.animOpen and 0 or -(rows * ROW_H)
		local tShift = DYN.tplOpen and 0 or -DYN.TPL_H
		DYN.animShift = aShift
		DYN.tplShift = tShift
		for _, b in pairs(selectorButtons) do b.Visible = DYN.animOpen end
		for _, b in pairs(templateButtons) do b.Visible = DYN.tplOpen end
		for c, d in pairs(belowItems) do
			local shift = aShift + (d.afterTpl and tShift or 0)
			c.Position = UDim2.new(d.pos.X.Scale, d.pos.X.Offset, 0, d.pos.Y.Offset + shift)
		end
		setFrameHeight((panel.Visible and openH or closedH) + aShift + tShift)
		DYN.animToggle.BackgroundColor3 = DYN.animOpen and COLOR_ON or COLOR_OFF
		DYN.tplToggle.BackgroundColor3 = DYN.tplOpen and COLOR_ON or COLOR_OFF
	end
	DYN.animToggle.MouseButton1Click:Connect(function()
		DYN.animOpen = not DYN.animOpen
		applyAnimLayout()
	end)
	DYN.tplToggle.MouseButton1Click:Connect(function()
		DYN.tplOpen = not DYN.tplOpen
		applyAnimLayout()
	end)
	applyAnimLayout()

	------------------------------------------------------------
	-- CIERRE: si este script se abre otra vez, el nuevo dispara el evento y este se limpia
	------------------------------------------------------------
	killEvent.Event:Connect(function()
		if dead then return end
		dead = true
		stopFPV()
		endSlow = 1
		for _, sess in pairs(sessions) do
			sess.stop = true -- las animaciones paran y restauran las articulaciones
		end
		for _, c in ipairs(conns) do
			pcall(function() c:Disconnect() end)
		end
		for _, b in ipairs(findBots()) do
			pcall(function() b:Destroy() end)
		end
		local bp = player:FindFirstChildOfClass("Backpack")
		local t1 = bp and bp:FindFirstChild("spawnbot")
		if t1 then t1:Destroy() end
		local t2 = player.Character and player.Character:FindFirstChild("spawnbot")
		if t2 then t2:Destroy() end
		pcall(function() endSound:Stop() endSound:Destroy() end)
		pcall(function() flashGui:Destroy() end)
		pcall(function() gui:Destroy() end)
	end)
