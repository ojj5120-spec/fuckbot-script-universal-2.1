	local loadBodyMesh = false -- true = pone los meshes del cuerpo del avatar (ej. cuerpo de mujer); false = cuerpo de bloque normal

	local function recolorMorphs(bot, color)
		for _, d in ipairs(bot:GetChildren()) do
			if d.Name == "MorphMesh" and not d:GetAttribute("FixedColor") then
				d.Color = color
			end
		end
	end

	local function clearBotClothes(bot)
		for _, c in ipairs(bot:GetChildren()) do
			if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") or c:IsA("Accessory") or c:IsA("CharacterMesh") then
				if c:IsA("CharacterMesh") then DYN.cmDirty = true end
				c:Destroy()
			end
		end
	end

	local function applyAppearance(bot, entry)
		if not bot or not bot.Parent or not entry then return end
		local hum = bot:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		clearBotClothes(bot)
		local desc = entry.desc:Clone()
		-- botsito es un R6 de tamano normal: se ignoran las escalas del avatar original
		pcall(function()
			desc.HeightScale = 1
			desc.WidthScale = 1
			desc.DepthScale = 1
			desc.HeadScale = 1
			desc.BodyTypeScale = 0
			desc.ProportionScale = 0
		end)
		if not loadBodyMesh then
			-- sin meshes de cuerpo: queda el bloque normal
			desc.Head = 0
			desc.Torso = 0
			desc.LeftArm = 0
			desc.RightArm = 0
			desc.LeftLeg = 0
			desc.RightLeg = 0
		end
		entry.torso = desc.Torso -- el torso que trae este avatar (0 si "Load body mesh" esta apagado)
		local ok, err = DYN.applyBotDesc(hum, desc)
		if not ok then
			warn("[Apariencia] Error al aplicar:", err)
			return
		end
		currentColor = desc.TorsoColor -- el color del cuerpo pasa a ser el del avatar
		recolorMorphs(bot, currentColor)
		DYN.catalogDirty = true -- el Bot catalog vuelve a poner sus accesorios
	end
