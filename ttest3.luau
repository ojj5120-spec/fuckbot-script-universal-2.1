local function makeToggle(label, xOffset, getter, setter)
	local t = Instance.new("TextButton")
	t.Size = UDim2.fromOffset(88, 24)
	t.Position = UDim2.fromOffset(xOffset, 92)
	t.Font = Enum.Font.GothamBold
	t.TextSize = 12
	t.TextColor3 = Color3.new(1, 1, 1)
	t.BorderSizePixel = 0
	t.Parent = frame
	Instance.new("UICorner", t).CornerRadius = UDim.new(0, 8)
	local function refresh()
		local v = getter()
		t.Text = label .. ": " .. tostring(v)
		t.BackgroundColor3 = v and COLOR_TRUE or COLOR_FALSE
	end
	t.MouseButton1Click:Connect(function()
		setter(not getter())
		refresh()
	end)
	refresh()
end

