-- LocalScript -> ponerlo en StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

------------------------------------------------------------
-- UNA SOLA INSTANCIA: si el script se abre otra vez, el anterior se cierra solo
-- (para animaciones, borra a botsito, quita la tool y la GUI) y este lo reemplaza
------------------------------------------------------------
do
	local old = player:FindFirstChild("PlayAnimInstance")
	if old then
		pcall(function() old:Fire() end)
		task.wait(0.4)
		pcall(function() old:Destroy() end)
	end
	-- restos de versiones viejas que no tenian este sistema
	local pg = player:WaitForChild("PlayerGui")
	for _, n in ipairs({ "PlayAnimGui", "EndFlash" }) do
		local g = pg:FindFirstChild(n)
		if g then g:Destroy() end
	end
	for _, b in ipairs(workspace:GetChildren()) do
		if b.Name == "botsito" then b:Destroy() end
	end
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp and bp:FindFirstChild("spawnbot") then bp.spawnbot:Destroy() end
	if player.Character and player.Character:FindFirstChild("spawnbot") then player.Character.spawnbot:Destroy() end
end

local killEvent = Instance.new("BindableEvent")
killEvent.Name = "PlayAnimInstance"
killEvent.Parent = player
local dead = false
local cleanups = {}   -- funciones que se ejecutan al cerrar este script
local conns = {}      -- conexiones globales que se desconectan al cerrar
local function track(c) table.insert(conns, c) return c end

